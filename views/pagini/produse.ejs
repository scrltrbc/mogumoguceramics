<!DOCTYPE html>
<html  lang="ro">
<head>
    <meta name="keywords" content="mogumoguceramics, ceramica, produse din ceramica, handmade, vaze, vaza, vaza din ceramica,
     flori, floare, flori din ceramica, breloc, brelocuri, breloc personalizat, breloc din ceramica personalizat, vesela,
      farfurie, farfurii, farfurii personalizate, frafurii personalizate din ceramica, farfurii pictate manual, cani, cana,
       cana personalizata, cana din ceramica, cana din ceramica pictata manual, figurine, figurine din ceramica, figurina,
       figurina ceramica, ceramic trinkets">
    <meta name="description" content="mogumoguceramics ofera creatii lucrate si pictate manual din ceramica">
    <%- include("../fragmente/head") %>
    <link rel="stylesheet" href="/resurse/css/produse.css" type="text/css" />
    <title>mogumoguceramics - Produse</title>
    <%- include("../fragmente/head") %>
    <script type="text/javascript" src=/resurse/js/produse.js></script>
    <script type="text/javascript" src=/resurse/js/produse-cos.js></script>

</head>
<body>


<%- include("../fragmente/header") %>

<main>
    <section class="zona-filtre">

        <label>
            Nume:
            <input type="text" id="inp-nume">
        </label>

        <label>
            <div class="range-wrapper">

                <span class="range-min" id="valMin"><%= pretMin %></span>

                <div class="slider-container">

                    <div class="slider-track"></div>

                    <input type="range"
                           id="inp-pret-min"
                           min="<%= pretMin %>"
                           max="<%= pretMax %>"
                           value="<%= pretMin %>">

                    <input type="range"
                           id="inp-pret-max"
                           min="<%= pretMin %>"
                           max="<%= pretMax %>"
                           value="<%= pretMax %>">

                </div>

                <span class="range-max" id="valMax">
        <%= pretMax %>
        (<span id="infoRange"></span>)
    </span>

            </div>

        <label>

            Categorie:

            <select id="inp-categorie">

                <option value="toate">
                    toate
                </option>

                <% for(let opt of locals.optiuni){ %>

                    <option value="<%= opt.unnest %>">
                        <%= opt.unnest %>
                    </option>

                <% } %>

            </select>

        </label>

        <div class="butoane">

            <button id="filtrare">
                Filtreaza
            </button>

            <button id="resetare">
                Reseteaza
            </button>

            <button id="sortCrescNume">
                Sorteaza crescator
            </button>

            <button id="sortDescrescNume">
                Sorteaza descrescator
            </button>

        </div>

        <p id="p-suma">
            Apasa Alt + C pentru suma produselor afisate.
        </p>

    </section>

    <section id="produse">

        <h2>Produse</h2>

        <div class="grid-produse">

            <% for(let prod of locals.produse){ %>

                <article
                        id="articol_<%- prod.id %>"
                        class="produs <%- prod.categorie.toLowerCase().replaceAll(' ','-') %>">
                    <a href="/produs/<%- prod.id %>" class="link-produs">

                    <!-- TITLU -->

                    <h3 class="titlu-prod">

                    <span class="val-nume">
                        <%- prod.denumire %>
                    </span>

                    </h3>



                    <!-- CATEGORIE -->

                    <p class="categorie">

                        categorie:
                        <span class="val-categorie">
                        <%- prod.categorie %>
                    </span>

                    </p>



                    <!-- DESCRIERE + IMAGINE -->

                    <div class="continut-prod">

                        <div class="descriere-box">

                            <p class="descriere">

                            <span class="val-descriere">
                                <%- prod.descriere %>
                            </span>

                            </p>

                        </div>

                            <img
                                    src="/resurse/imagini/produse/<%- prod.imagine %>"
                                    alt="<%- prod.denumire %>">


                    </div>



                    <!-- LISTA CARACTERISTICI -->

                    <ul class="lista-caracteristici">

                        <!-- caracteristica numerica -->

                        <li>

                            pret:
                            <span class="val-pret">
                            <%- prod.pret %>
                        </span>
                            lei

                        </li>



                        <!-- caracteristica string simplu -->

                        <li>

                            culoare:
                            <span class="val-culoare">
                            <%- prod.culoare %>
                        </span>

                        </li>



                        <!-- caracteristica cu mai multe valori -->

                        <li>

                            materiale:
                            <span class="val-materiale">

                                <% if(Array.isArray(prod.materiale)){ %>

                                    <%- prod.materiale.join(", ") %>

                                <% } else { %>

                                    <%- prod.materiale %>

                                <% } %>

                            </span>

                        </li>



                        <!-- caracteristica data -->

                        <li>

                            data_adaugare:

                            <time datetime="<%- prod.data_adaugare %>">

                                <%= new Date(prod.data_adaugare)
                                        .toLocaleDateString(
                                                "ro-RO",
                                                {
                                                    weekday: "long",
                                                    day: "numeric",
                                                    month: "long",
                                                    year: "numeric"
                                                }
                                        ) %>

                            </time>

                        </li>



                        <!-- caracteristica booleana -->

                        <li>

                            personalizabil:
                            <span class="val-personalizabil">

                            <%= prod.personalizabil ? "da" : "nu" %>

                        </span>

                        </li>

                    </ul>
                    </a>
                </article>

            <% } %>

        </div>

    </section>
</main>

<%- include("../fragmente/footer") %>
</body>
</html>