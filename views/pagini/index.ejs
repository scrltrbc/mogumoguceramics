<body>
<header>
    <%- include("../fragmente/header") %>
</header>
<main>
    <div id="grid-pagina">
        <section id="welcome">
            <div class="intro-oferte">
                <h1 class="titlusite">mogumoguceramics</h1>
                <div id="sigla-site">
                    <a href="/resurse/imagini/mogumogutransparent.png"><img
                                src="/resurse/imagini/mogumogutransparent.png"
                                alt="sigla" width="400" height="auto"/></a>
                </div>
            </div>
            <hgroup>
                <h2>Bine ati venit</h2>
                <p class="subtitlu">Despre</p>
            </hgroup>
            <blockquote>„Nu am vrut să sculptez pasărea, am vrut să sculptez zborul.”</blockquote>
            <p class="intro">mogumoguceramics este un artist autohton ce se indeletniceste cu
                mestesugul ceramicii, sculptand, pictand si finisand operele sale.</p>
            <section id="promotii">
                <h3>Promoții și oferte</h3>
                <article>
                    <h3 class="titlu">Super ofertă de luna îndrăgostiților</h3>
                    <p><b>mogumoguceramics</b> oferă <b>reduceri de <s>10%</s>
                            <ins>14%</ins>
                        </b> pentru toate produsele cumpărate în luna februarie.
                    </p>
                </article>
                <article>
                    <h3>Ofertă FMI</h3>
                    <p>50% reducere la orice produs pentru cine poate rezolva următoarea ecuație:
                        <math>
                            <mrow>
                                <msup>
                                    <mfenced>
                                        <mrow>
                                            <mi>a</mi>
                                            <mo>+</mo>
                                            <mi>b</mi>
                                        </mrow>
                                    </mfenced>
                                    <mn>2</mn>
                                </msup>
                                <mo>=</mo>
                                <mn>0</mn>
                            </mrow>
                        </math>
                    </p>
                </article>
            </section>
            <div id="stadiusite">
                <h2>Nivelul de completare a site-ului</h2>
                <meter id="sitecomplet" min="0" max="14" low="5" high="10" optimum="12" value="1"></meter>
                1/14
            </div>
            <div id="dv-prezentare-1">
                <div id="dv-prezentare">
                    <figure>
                        <picture>
                            <!-- il ia pe primul care se potriveste cu query-ul din media-->
                            <source srcset="/resurse/imagini/produse/galaxiefloriviolet288x344.png"
                                    media="(max-width:700px)"/>
                            <source srcset="/resurse/imagini/produse/galaxiefloriviolet486x648.png"
                                    media="(max-width:1200px)"/>
                            <img src="/resurse/imagini/produse/galaxiefloriviolet576x768.png" alt="text"
                                 title="Galaxia Florilor"/>
                        </picture>
                        <figcaption>Puzderie de flori</figcaption>
                    </figure>
                    <figure id="fig1" class="fg-img">
                        <a href="/resurse/imagini/produse/movgalben1.jpeg" download="poza.jpeg"><img
                                    src="/resurse/imagini/produse/movgalben1.jpeg" style="width:50%; height: auto;"
                                    alt="vaza cu flori"></a>
                        <figcaption>vaza galbenă</figcaption>
                    </figure>
                </div>
            </div>
        </section>
        <section id="produse">
            <h2>Produsele noastre</h2>
            <section id="vaze">
                <h3>Vaze</h3>
