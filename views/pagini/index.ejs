                    <source src="/resurse/video/Chocolate.ogv" type="video/ogv">

                    <track src="/resurse/video/tracks/captions-ciocolata.vtt" kind="subtitles" srclang="ro" label="Română" default>
                    <track src="/resurse/video/tracks/captions-ciocolata-en.vtt" kind="subtitles" srclang="en" label="English">
                </video>
            </section>
            <section id="galerie-statica">
