                        <figcaption>Briose</figcaption>
                    </figure>
                    <figure>
                        <img src="/resurse/imagini/produse/proces1.jpeg" style="width:50%; height: 50%;" alt="briose">
                        <figcaption>Briose</figcaption>
                    </figure>
                    <figure>
                        <img src="/resurse/imagini/produse/proces2.jpeg" style="width:50%; height: 50%;" alt="briose">
                        <figcaption>Briose</figcaption>
                    </figure>
                </div>
            </section>
