nav {
  --latime-buton: 120px;
  --inaltime-buton: 30px;
  background-color: var(--buton);
}

ul.meniu, ul.meniu ul {
  list-style-type: none;
  padding: 0;
  margin: 0;
}

#hamburger, #ch-menu {
  display: none;
}

.text-icon, .imag-icon {
  display: inline-block;
}

ul.submeniu > li, ul.meniu > li {
  cursor: pointer;
  font-weight: bold;
  width: var(--latime-buton);
  height: var(--inaltime-buton);
  background-color: var(--buton);
  border: 1px solid var(--buton);
  color: var(--text-hover) !important;
  text-align: center;
  line-height: var(--inaltime-buton);
  text-decoration: none;
  transition: all 0.25s linear;
  display: block;
  position: relative;
}

ul.meniu {
  display: flex;
  position: relative;
}

ul.meniu > li::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 3px;
  background: linear-gradient(to left, var(--buton), var(--buton-hover));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.1s ease;
}
ul.meniu > li:hover::after {
  transform: scaleX(1);
}

@keyframes animatie_submeniu {
  0% {
    opacity: 0;
    transform: scale(0, 0);
  }
  50% {
    opacity: 1;
    transform: scale(1, 0);
  }
  100% {
    opacity: 1;
    transform: scale(1, 1);
  }
}
ul.meniu > li:hover ul {
  display: block;
  position: absolute;
  z-index: 17;
}

ul.meniu a,
ul.meniu a:link,
ul.meniu a:visited {
  text-decoration: none;
  color: var(--text) !important;
  display: block;
  width: 100%;
  height: 100%;
}

ul.meniu a:hover {
  color: var(--text) !important;
}

ul.meniu > li:hover {
  background-color: var(--buton-hover);
  color: var(--text) !important;
}
ul.meniu > li:hover > a {
  color: var(--text) !important;
}

ul.submeniu {
  display: none;
  animation: animatie_submeniu 0.25s linear;
  transform-origin: center;
}
ul.submeniu > li:hover {
  background-color: var(--buton-hover);
  color: var(--text) !important;
}
ul.submeniu a {
  color: var(--text-hover) !important;
}
ul.submeniu a:hover {
  color: var(--text);
}

#buton-tema:hover {
  background-color: var(--buton) !important;
}
#buton-tema::after {
  width: 0% !important;
}